<mujoco model="panda cube lift">
  <include file="panda.xml"/>

  <statistic center="0.45 0 0.45" extent="1.1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-25" offwidth="960" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.55 0.46 0.36 1"/>
    <material name="cube_mat" rgba="0.85 0.19 0.19 1"/>
  </asset>

  <worldbody>
    <light pos="0.5 0 2.0" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Table top sits at z = 0.4 -->
    <body name="table" pos="0.55 0 0.2">
      <geom name="table_top" type="box" size="0.30 0.40 0.20" material="table_mat"
            friction="1 0.005 0.0001"/>
    </body>

    <!-- 4 cm cube, free to move. Gripper spans 8 cm fully open, so 4 cm leaves margin. -->
    <body name="cube" pos="0.55 0 0.42">
      <freejoint name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" material="cube_mat"
            mass="0.05" friction="1.5 0.02 0.001" condim="4"
            solimp="0.95 0.99 0.001" solref="0.005 1"/>
    </body>

    <camera name="grasp_cam" pos="1.25 -0.95 1.05" mode="targetbody" target="table"/>
    <camera name="front_cam" pos="1.70 0 0.85" mode="targetbody" target="table"/>
    <!-- Perception camera: fixed, opposite the robot, ~47 deg down, aimed at the
         workspace centre (0.55, 0, 0.42) from 0.73 m. Fixed pose so its
         calibration is constant. -->
    <camera name="table_cam" pos="1.05 0 0.95" xyaxes="0 1 0 -0.7274 0 0.6862" fovy="45"/>
  </worldbody>

  <!-- panda.xml's "home" key only specifies the 9 arm/finger qpos. This model
       has nq=16, and MuJoCo zero-pads the remainder, which drops the cube at
       the world origin. This key spells out the cube pose so that loading the
       scene in the viewer shows the cube on the table. -->
  <keyframe>
    <key name="start"
         qpos="0 0 0 -1.57079 0 1.57079 -0.7853 0.04 0.04  0.55 0 0.42  1 0 0 0"
         ctrl="0 0 0 -1.57079 0 1.57079 -0.7853 255"/>
  </keyframe>
</mujoco>
